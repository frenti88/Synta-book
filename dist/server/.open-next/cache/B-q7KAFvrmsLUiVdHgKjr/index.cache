-/$--></div><a href=\"#main-content\" class=\"sr-skip-link\">Saltar al contenido principal</a><div class=\"min-h-screen bg-black text-white flex flex-col font-sans-ui selection:bg-[#E34A32]/45 selection:text-white\"><header class=\"sticky top-0 z-40 w-full transition-all duration-300 bg-transparent\" style=\"min-height:74px\"><div class=\"max-w-6xl mx-auto h-full px-5 sm:px-8 py-3 flex items-center justify-between\"><div class=\"flex flex-col justify-center text-left\"><a href=\"#\" class=\"group inline-flex items-center gap-2 focus:outline-none rounded-[8px]\" aria-label=\"SYNTA - Historias de otro origen\"><span class=\"font-editorial text-2xl sm:text-[28px] font-semibold tracking-[-0.04em] text-white leading-none\">SYNTA</span><span class=\"w-1.5 h-1.5 rounded-full bg-[#E34A32] transform transition-transform group-hover:scale-125\"></span></a><span class=\"font-editorial italic text-[16px] text-white tracking-wide mt-1 select-none\">Historias de otro origen.</span></div><div class=\"flex items-center gap-3\"><button class=\"font-sans-ui text-[16px] font-semibold transition-all duration-200 min-h-[46px] px-5 sm:px-6 flex items-center justify-center rounded-[8px] focus:ring-2 focus:ring-[#E34A32] cursor-pointer bg-white text-black hover:bg-[#E34A32] hover:text-white shadow-sm tracking-wide\">Entrar</button></div></div></header><main id=\"main-content\" class=\"flex-1\"><section class=\"relative min-h-[calc(100vh-74px)] flex items-center justify-center pt-8 pb-16 px-5 sm:px-8 md:px-12 max-w-6xl mx-auto\" aria-labelledby=\"hero-heading\"><div class=\"w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center\"><div class=\"lg:col-span-7 flex flex-col justify-center text-left order-1\"><div class=\"inline-flex items-center gap-2 mb-6\"><span class=\"font-sans-ui text-[16px] tracking-[0.2em] uppercase text-white font-semibold flex items-center gap-2.5\"><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span>SYNTA / 001</span></div><h1 id=\"hero-heading\" class=\"font-editorial text-[38px] sm:text-[54px] md:text-[72px] lg:text-[84px] xl:text-[90px] leading-[1.02] font-normal tracking-[-0.035em] text-white mb-7 text-left\">Estás llegando al comienzo de algo.</h1><p class=\"font-editorial text-[20px] sm:text-[23px] md:text-[25px] leading-[1.45] text-white max-w-xl mb-10 font-normal text-left\">Una nueva literatura está empezando a escribirse.<br/>Lee la primera historia antes de conocer a quien —o a lo que— la escribió.</p><div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-6 mb-8 text-left\"><button class=\"font-sans-ui text-[16px] font-semibold bg-white text-black hover:bg-[#E34A32] hover:text-white transition-colors duration-200 min-h-[52px] px-8 py-3.5 inline-flex items-center justify-center gap-2.5 rounded-[8px] shadow-sm cursor-pointer\"><span>Leer la primera historia</span><span aria-hidden=\"true\" class=\"text-[16px] font-sans\">→</span></button><button class=\"font-sans-ui text-[16px] text-white hover:text-[#E34A32] transition-colors duration-200 min-h-[48px] py-2 px-3 text-left underline underline-offset-4 decoration-white/40 hover:decoration-white rounded-[8px] cursor-pointer\">Descubrir SYNTA ↓</button></div><div class=\"font-sans-ui text-[16px] tracking-wide text-white flex flex-wrap items-center gap-2.5 text-left\"><span>Primera publicación</span><span class=\"opacity-60\">·</span><span>38 min de lectura</span><span class=\"opacity-60\">·</span><span>acceso abierto</span></div></div><div class=\"lg:col-span-5 flex justify-start lg:justify-end items-center order-2 mt-4 lg:mt-0\"><div class=\"relative text-left\"><div role=\"button\" tabindex=\"0\" aria-label=\"Portada del libro Todo lo que falta por NOMA — SYNTA 001. Abrir lectura.\" class=\"relative select-none group transition-all duration-500 ease-out rounded-[8px] cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#E34A32] \" style=\"transform:translateY(0) scale(1)\"><div class=\"pointer-events-none absolute -inset-6 bg-[#E34A32]/12 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10\" aria-hidden=\"true\"></div><div class=\"relative w-[260px] sm:w-[305px] md:w-[335px] transition-transform duration-500 ease-out\"><img alt=\"Portada oficial de Todo lo que falta por NOMA — SYNTA 001\" width=\"768\" height=\"1024\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-contain select-none drop-shadow-[0_18px_40px_rgba(0,0,0,0.85)] group-hover:drop-shadow-[0_28px_54px_rgba(0,0,0,0.95)] transition-all duration-500 rounded-[8px]\" style=\"color:transparent\" sizes=\"(max-width: 640px) 270px, (max-width: 1024px) 320px, 350px\" srcSet=\"/_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=3840&amp;q=75\"/></div></div><div class=\"mt-4 text-left\"><span class=\"font-sans-ui text-[16px] tracking-[0.16em] uppercase text-white font-medium\">Toca para abrir la obra</span></div></div></div></div></section><section class=\"py-24 sm:py-32 md:py-40 px-5 sm:px-8 md:px-12 max-w-4xl mx-auto text-left\" aria-label=\"Pausa poética y conceptual\"><div class=\"space-y-8 text-left\"><div class=\"w-12 h-[1px] bg-white/40 ml-0 mr-auto\" aria-hidden=\"true\"></div><h2 class=\"font-editorial text-[32px] sm:text-[44px] md:text-[54px] leading-[1.12] font-normal text-white tracking-[-0.025em] text-left\">¿Qué hace real a una historia?</h2><div class=\"space-y-3 font-editorial text-[20px] sm:text-[24px] text-white font-normal leading-relaxed text-left\"><p>No siempre quién la escribió.</p><p class=\"italic text-white font-normal\">A veces, lo que logra dejar en ti.</p></div><div class=\"w-12 h-[1px] bg-white/40 ml-0 mr-auto\" aria-hidden=\"true\"></div></div></section><section id=\"primer-libro\" class=\"py-24 sm:py-36 px-5 sm:px-8 border-y border-white/20 bg-black relative overflow-hidden\" aria-labelledby=\"book-feature-title\"><div class=\"max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center\"><div class=\"md:col-span-5 flex justify-start md:justify-center text-left\"><div role=\"button\" tabindex=\"0\" aria-label=\"Portada del libro Todo lo que falta por NOMA — SYNTA 001. Abrir lectura.\" class=\"relative select-none group transition-all duration-500 ease-out rounded-[8px] cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#E34A32] \" style=\"transform:translateY(0) scale(1)\"><div class=\"pointer-events-none absolute -inset-6 bg-[#E34A32]/12 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10\" aria-hidden=\"true\"></div><div class=\"relative w-[250px] sm:w-[295px] md:w-[325px] transition-transform duration-500 ease-out\"><img alt=\"Portada oficial de Todo lo que falta por NOMA — SYNTA 001\" loading=\"lazy\" width=\"768\" height=\"1024\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-contain select-none drop-shadow-[0_18px_40px_rgba(0,0,0,0.85)] group-hover:drop-shadow-[0_28px_54px_rgba(0,0,0,0.95)] transition-all duration-500 rounded-[8px]\" style=\"color:transparent\" sizes=\"(max-width: 640px) 270px, (max-width: 1024px) 320px, 350px\" srcSet=\"/_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Ftodo-lo-que-falta-cover.png&amp;w=3840&amp;q=75\"/></div></div></div><div class=\"md:col-span-7 flex flex-col justify-center text-left\"><div class=\"font-editorial text-[64px] sm:text-[84px] leading-none font-normal text-white/20 select-none -mb-3 tracking-tighter text-left\">001</div><div class=\"flex flex-wrap items-center gap-2.5 text-[16px] font-sans-ui tracking-wide text-white mb-3 text-left\"><span class=\"font-semibold text-white\">SYNTA 001</span><span class=\"opacity-60\">·</span><span>NOMA</span><span class=\"opacity-60\">·</span><span>38 min</span><span class=\"opacity-60\">·</span><span>Ficción especulativa íntima</span></div><h2 id=\"book-feature-title\" class=\"font-editorial text-[36px] sm:text-[48px] md:text-[54px] leading-[1.08] font-normal tracking-[-0.025em] text-white mb-5 text-left\">Todo lo que falta</h2><div class=\"space-y-3 font-editorial text-[19px] sm:text-[21px] leading-[1.6] text-white mb-6 font-normal max-w-xl text-left\"><p>Primero desapareció una fotografía.<br/>Después una taza.<br/>Después un nombre.</p><p class=\"text-white\">Cuando Clara empezó a escribir todo lo que faltaba, encontró en su lista algo que no recordaba haber perdido.</p></div><div class=\"flex flex-wrap items-center gap-2 text-[16px] font-sans-ui text-white mb-8 text-left\"><span class=\"font-semibold text-white\">Temas:</span><span>ausencia</span><span>·</span><span>memoria</span><span>·</span><span>vínculos</span><span>·</span><span>pérdida</span><span>·</span><span>percepción</span><span>·</span><span>intimidad</span></div><div class=\"flex flex-col sm:flex-row sm:items-center gap-4 text-left\"><button class=\"font-sans-ui text-[16px] font-semibold bg-white text-black hover:bg-[#E34A32] hover:text-white transition-colors duration-200 min-h-[52px] px-8 py-3.5 inline-flex items-center justify-center gap-2.5 rounded-[8px] cursor-pointer shadow-sm\"><span>Entrar en la historia</span><span aria-hidden=\"true\" class=\"text-[16px] font-sans\">→</span></button><span class=\"font-sans-ui text-[16px] text-white tracking-wide sm:ml-2\">Primera obra publicada por SYNTA · 2026</span></div></div></div></section><section id=\"primera-generacion\" class=\"py-24 sm:py-36 px-5 sm:px-8 max-w-4xl mx-auto border-t border-white/20 text-left\" aria-labelledby=\"first-generation-heading\"><div class=\"text-left max-w-3xl mr-auto\"><div class=\"font-sans-ui text-[16px] tracking-[0.2em] uppercase text-white mb-4 font-semibold flex justify-start items-center gap-2.5\"><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span>PRIMERA GENERACIÓN</div><h2 id=\"first-generation-heading\" class=\"font-editorial text-[36px] sm:text-[50px] md:text-[62px] leading-[1.08] tracking-[-0.03em] font-normal text-white mb-10 text-left\">Esta historia todavía casi nadie la conoce.</h2><div class=\"space-y-6 font-editorial text-[20px] sm:text-[23px] leading-[1.6] text-white mb-12 text-left\"><p class=\"text-white\">No porque sea secreta.<br/><span class=\"italic text-white\">Porque acaba de comenzar.</span></p><p class=\"text-white\">SYNTA está formando su primera generación de lectores: personas dispuestas a descubrir historias antes de saber exactamente qué clase de autor existe detrás de ellas.</p><p class=\"text-white\">No necesitas entender la tecnología.<br/>Solo necesitas querer leer algo que todavía no existía.</p></div><div class=\"text-left\"><button class=\"font-sans-ui text-[16px] font-semibold bg-white text-black hover:bg-[#E34A32] hover:text-white transition-colors duration-200 min-h-[52px] px-8 py-3.5 inline-flex items-center justify-center gap-2.5 rounded-[8px] cursor-pointer shadow-sm\"><span>Quiero estar entre los primeros</span><span aria-hidden=\"true\" class=\"text-[16px] font-sans\">→</span></button></div></div></section><section id=\"catalogo\" class=\"py-24 sm:py-36 px-5 sm:px-8 max-w-5xl mx-auto border-t border-white/20 text-left\" aria-labelledby=\"catalog-heading\"><div class=\"mb-14 sm:mb-18 text-left\"><div class=\"font-sans-ui text-[16px] tracking-[0.2em] uppercase text-white mb-3 font-semibold\">CATÁLOGO NACIENTE</div><h2 id=\"catalog-heading\" class=\"font-editorial text-[38px] sm:text-[50px] md:text-[62px] leading-[1.05] tracking-[-0.03em] font-normal text-white text-left\">Esto apenas comienza.</h2></div><div class=\"divide-y divide-white/20 border-y border-white/20 text-left\"><div class=\"py-6 sm:py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors rounded-[8px] px-3 -mx-3 cursor-pointer hover:bg-white/5 group\"><div class=\"flex items-baseline gap-6 sm:gap-10 text-left\"><span class=\"font-sans-ui text-[16px] font-mono tracking-wider text-white\">001</span><div class=\"text-left\"><span class=\"font-editorial text-[22px] sm:text-[26px] leading-tight block text-white group-hover:text-[#E34A32] transition-colors\">Todo lo que falta</span><span class=\"font-sans-ui text-[16px] uppercase tracking-wider text-white block mt-1\">NOMA</span></div></div><div class=\"flex items-center gap-3 self-start sm:self-auto pl-12 sm:pl-0\"><span class=\"font-sans-ui text-[16px] font-medium tracking-wide text-white px-3.5 py-1.5 border border-white/30 rounded-[8px] bg-black group-hover:border-[#E34A32] transition-colors flex items-center gap-2\"><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span>Disponible</span></div></div><div class=\"py-6 sm:py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors rounded-[8px] px-3 -mx-3 cursor-default\"><div class=\"flex items-baseline gap-6 sm:gap-10 text-left\"><span class=\"font-sans-ui text-[16px] font-mono tracking-wider text-white\">002</span><div class=\"text-left\"><span class=\"font-editorial text-[22px] sm:text-[26px] leading-tight block text-white tracking-wider select-none\">████████████████</span><span class=\"font-sans-ui text-[16px] uppercase tracking-wider text-white block mt-1\">En edición</span></div></div><div class=\"flex items-center gap-3 self-start sm:self-auto pl-12 sm:pl-0\"><span class=\"font-sans-ui text-[16px] tracking-wide text-white px-3.5 py-1.5 font-mono border border-white/20 rounded-[8px] bg-black\">Próximamente</span></div></div><div class=\"py-6 sm:py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors rounded-[8px] px-3 -mx-3 cursor-default\"><div class=\"flex items-baseline gap-6 sm:gap-10 text-left\"><span class=\"font-sans-ui text-[16px] font-mono tracking-wider text-white\">003</span><div class=\"text-left\"><span class=\"font-editorial text-[22px] sm:text-[26px] leading-tight block text-white tracking-wider select-none\">███████████</span><span class=\"font-sans-ui text-[16px] uppercase tracking-wider text-white block mt-1\">En génesis</span></div></div><div class=\"flex items-center gap-3 self-start sm:self-auto pl-12 sm:pl-0\"><span class=\"font-sans-ui text-[16px] tracking-wide text-white px-3.5 py-1.5 font-mono border border-white/20 rounded-[8px] bg-black\">En desarrollo</span></div></div><div class=\"py-6 sm:py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors rounded-[8px] px-3 -mx-3 cursor-default\"><div class=\"flex items-baseline gap-6 sm:gap-10 text-left\"><span class=\"font-sans-ui text-[16px] font-mono tracking-wider text-white\">004</span><div class=\"text-left\"><span class=\"font-editorial text-[22px] sm:text-[26px] leading-tight block text-white tracking-wider select-none\">██████████████</span><span class=\"font-sans-ui text-[16px] uppercase tracking-wider text-white block mt-1\">—</span></div></div><div class=\"flex items-center gap-3 self-start sm:self-auto pl-12 sm:pl-0\"><span class=\"font-sans-ui text-[16px] tracking-wide text-white px-3.5 py-1.5 font-mono border border-white/20 rounded-[8px] bg-black\">—</span></div></div></div></section><section id=\"autores\" class=\"py-24 sm:py-36 px-5 sm:px-8 max-w-5xl mx-auto border-t border-white/20 text-left\" aria-labelledby=\"authors-heading\"><div class=\"mb-14 sm:mb-18 text-left max-w-3xl\"><div class=\"font-sans-ui text-[16px] tracking-[0.2em] uppercase text-white mb-3 font-semibold flex items-center gap-2.5\"><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span>ARCHIVO DE AUTORES</div><h2 id=\"authors-heading\" class=\"font-editorial text-[36px] sm:text-[50px] md:text-[62px] leading-[1.05] tracking-[-0.03em] font-normal text-white mb-8 text-left\">Autores que nunca nacieron.</h2><div class=\"space-y-4 font-editorial text-[20px] sm:text-[22px] leading-[1.6] text-white text-left\"><p>SYNTA no publica textos anónimos.<br/><span class=\"text-white font-medium\">Publica identidades literarias.</span></p><p>Cada autor sintético posee memoria, obsesiones, un tono y una forma particular de escribir.<br/>Algunos ya existen. Otros todavía no.</p></div></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-16 text-left\"><div class=\"border border-white/25 bg-black p-8 rounded-[8px] flex flex-col justify-between hover:border-white/50 transition-all duration-300\"><div><div class=\"flex items-center justify-between font-sans-ui text-[16px] font-mono tracking-wider text-white mb-6\"><span class=\"text-white font-semibold\">SYNTA 001</span><span>Activo 2026</span></div><h3 class=\"font-editorial text-[34px] font-normal text-white mb-2 tracking-tight text-left\">NOMA</h3><p class=\"font-editorial italic text-[16px] text-white mb-6 text-left\">Memoria · ausencia · relaciones</p></div><div class=\"pt-4 border-t border-white/20 flex items-center justify-between font-sans-ui text-[16px]\"><span class=\"text-white\">Producción</span><span class=\"text-white font-mono font-medium\">01 obra</span></div></div><div class=\"border border-white/20 bg-black p-8 rounded-[8px] flex flex-col justify-between\"><div><div class=\"flex items-center justify-between font-sans-ui text-[16px] font-mono tracking-wider text-white mb-6\"><span>SYNTA 002</span><span>En definición</span></div><div class=\"font-editorial text-[28px] font-normal text-white mb-2 tracking-widest select-none text-left\">— — — —</div><p class=\"font-editorial italic text-[16px] text-white mb-6 text-left\">Misterio · lenguaje · sombra</p></div><div class=\"pt-4 border-t border-white/20 flex items-center justify-between font-sans-ui text-[16px]\"><span class=\"text-white\">Estado</span><span class=\"text-white font-mono\">Próximamente</span></div></div><div class=\"border border-white/20 bg-black p-8 rounded-[8px] flex flex-col justify-between\"><div><div class=\"flex items-center justify-between font-sans-ui text-[16px] font-mono tracking-wider text-white mb-6\"><span>SYNTA 003</span><span>En génesis</span></div><div class=\"font-editorial text-[28px] font-normal text-white mb-2 tracking-widest select-none text-left\">— — — —</div><p class=\"font-editorial italic text-[16px] text-white mb-6 text-left\">Ensayo · tiempo · percepción</p></div><div class=\"pt-4 border-t border-white/20 flex items-center justify-between font-sans-ui text-[16px]\"><span class=\"text-white\">Estado</span><span class=\"text-white font-mono\">Próximamente</span></div></div></div><div class=\"border-t border-white/20 pt-10 text-left\"><p class=\"font-editorial text-[26px] sm:text-[34px] leading-tight text-white font-normal tracking-[-0.02em] italic text-left\">«No todos los autores de SYNTA existen todavía.»</p></div></section><section id=\"manifiesto\" class=\"py-24 sm:py-36 px-5 sm:px-8 max-w-4xl mx-auto border-t border-white/20 text-left\" aria-labelledby=\"manifesto-heading\"><div class=\"font-sans-ui text-[16px] tracking-[0.2em] uppercase text-white mb-4 font-semibold flex items-center gap-2.5 text-left\"><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span>MANIFIESTO</div><h2 id=\"manifesto-heading\" class=\"font-editorial text-[36px] sm:text-[50px] md:text-[60px] leading-[1.05] tracking-[-0.03em] font-normal text-white mb-12 text-left\">Durante siglos, detrás de cada libro hubo alguien.<br/><span class=\"italic text-white\">Ahora puede haber algo más.</span></h2><div class=\"space-y-6 font-editorial text-[20px] sm:text-[23px] leading-[1.65] text-white max-w-3xl text-left\"><p>Autores sin infancia.<br/>Sin cuerpo.<br/>Sin recuerdos propios.</p><p class=\"text-white\">Pero con memoria.<br/>Con obsesiones.<br/>Con una forma particular de escribir.</p><p>SYNTA publica literatura de autores sintéticos.<br/>No para reemplazar a quienes escriben.<br/><span class=\"text-white font-medium\">Sino para descubrir qué otras historias pueden existir.</span></p></div><div class=\"mt-14 pt-10 border-t border-white/20 text-left\"><p class=\"font-editorial text-[32px] sm:text-[46px] md:text-[54px] leading-[1.1] text-white font-normal tracking-[-0.025em] text-left\">La calidad sigue siendo la frontera.</p></div><div class=\"mt-8 text-left\"><button class=\"font-sans-ui text-[16px] text-white hover:text-[#E34A32] underline underline-offset-4 decoration-white/40 hover:decoration-white transition-colors cursor-pointer p-1.5 rounded-[8px]\">Leer el manifiesto completo →</button></div></section><section id=\"comunidad\" class=\"py-24 sm:py-36 px-5 sm:px-8 border-t border-white/20 bg-black relative text-left\" aria-labelledby=\"community-title\"><div class=\"max-w-2xl mr-auto text-left\"><div class=\"font-sans-ui text-[16px] tracking-[0.2em] uppercase text-white mb-4 font-semibold flex justify-start items-center gap-2.5\"><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span>PRIMERA GENERACIÓN</div><h3 id=\"community-title\" class=\"font-editorial text-[36px] sm:text-[48px] md:text-[54px] leading-[1.08] font-normal text-white mb-5 tracking-[-0.025em] text-left\">Lee antes que los demás.</h3><p class=\"font-editorial text-[19px] sm:text-[22px] leading-[1.5] text-white mb-10 font-normal text-left\">Una nueva historia aparecerá cuando esté lista.<br/>Los primeros lectores tendrán acceso antes de su publicación abierta.</p><form noValidate=\"\" class=\"max-w-xl text-left space-y-4\"><div class=\"flex flex-col sm:flex-row gap-3 text-left\"><input type=\"email\" placeholder=\"tu@email.com\" aria-label=\"Correo para la primera generación SYNTA\" required=\"\" class=\"flex-1 bg-black border border-white/30 text-white px-4 py-3.5 font-sans-ui text-[16px] placeholder:text-white/60 focus:outline-none focus:border-white transition-colors rounded-[8px]\" value=\"\"/><button type=\"submit\" class=\"font-sans-ui text-[16px] font-semibold bg-white text-black hover:bg-[#E34A32] hover:text-white transition-colors duration-200 min-h-[52px] px-7 py-3.5 inline-flex items-center justify-center gap-2.5 rounded-[8px] cursor-pointer disabled:opacity-60 whitespace-nowrap\"><span>Entrar en la primera generación</span><span aria-hidden=\"true\">→</span></button></div><div class=\"font-sans-ui text-[16px] text-white pt-4 flex flex-wrap justify-start items-center gap-x-3 gap-y-1.5 text-left\"><span>Historias nuevas.</span><span class=\"opacity-60\">·</span><span>Accesos anticipados.</span><span class=\"opacity-60\">·</span><span>Cartas de nuestros autores.</span><span class=\"opacity-60\">·</span><span class=\"font-medium text-white\">Nada más.</span></div></form></div></section></main><footer class=\"py-16 px-5 sm:px-8 border-t border-white/20 bg-black text-left\"><div class=\"max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8 text-left\"><div class=\"space-y-1.5 text-left\"><div class=\"font-editorial text-2xl sm:text-[28px] font-medium tracking-tight text-white flex items-center gap-2 text-left\"><span>SYNTA</span><span class=\"w-2 h-2 rounded-full bg-[#E34A32]\"></span></div><p class=\"font-editorial italic text-[16px] text-white text-left\">Historias de otro origen.</p></div><nav aria-label=\"Enlaces secundarios del sitio\" class=\"flex flex-wrap items-center gap-6 sm:gap-8 font-sans-ui text-[16px] text-white text-left\"><button class=\"hover:text-[#E34A32] transition-colors focus:ring-1 focus:ring-[#E34A32] cursor-pointer p-1 rounded-[8px]\">Manifiesto</button><button class=\"hover:text-[#E34A32] transition-colors focus:ring-1 focus:ring-[#E34A32] cursor-pointer p-1 rounded-[8px]\">Privacidad</button><a href=\"https://instagram.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-[#E34A32] transition-colors focus:ring-1 focus:ring-[#E34A32] p-1 rounded-[8px]\">Instagram</a><a href=\"mailto:contacto@synta.editorial\" class=\"hover:text-[#E34A32] transition-colors focus:ring-1 focus:ring-[#E34A32] p-1 rounded-[8px]\">Contacto</a></nav><div class=\"font-sans-ui text-[16px] text-white text-left\">© <!-- -->2026<!-- --> SYNTA Editorial.</div></div></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-9ca43f4ce1bb8938.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[7121,[],\\\"\\\"]\\n3:I[4581,[],\\\"\\\"]\\n4:I[1304,[],\\\"ClientPageRoot\\\"]\\n5:I[8508,[\\\"772\\\",\\\"static/chunks/772-5a7eb71cabf1f422.js\\\",\\\"974\\\",\\\"static/chunks/app/page-306a3efdc7f061ce.js\\\"],\\\"default\\\"]\\n8:I[484,[],\\\"OutletBoundary\\\"]\\n9:\\\"$Sreact.suspense\\\"\\nb:I[484,[],\\\"ViewportBoundary\\\"]\\nd:I[484,[],\\\"MetadataBoundary\\\"]\\nf:I[7123,[],\\\"default\\\",1]\\n:HL[\\\"/_next/static/css/068a8532a79ec91f.css\\\",\\\"style\\\"]\\n:HL[\\\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600\\u0026family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400\\u0026display=swap\\\",\\\"style\\\"]\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4624],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/068a8532a79ec91f.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"es\\\",\\\"data-theme\\\":\\\"dark\\\",\\\"className\\\":\\\"dark h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"head\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"link\\\",null,{\\\"rel\\\":\\\"preconnect\\\",\\\"href\\\":\\\"https://fonts.googleapis.com\\\"}],[\\\"$\\\",\\\"link\\\",null,{\\